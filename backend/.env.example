# Resolved relative to the backend directory, independent of current directory.
VOICE_AI_AGENT_PATH=../../VoiceAIAgentPro
# Optional real integrations. Keep secrets in ignored .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEMGREP_CONFIG=
CODELY_SCANNER_ADAPTER=
CODELY_ARCHITECTURE_ADAPTER=
CODELY_EXPLANATION_ADAPTER=

# Optional live Member 4 provider. Only enable for approved repository text.
CODELY_ALLOW_EXTERNAL_AI=0
M4_PROVIDER=gemini
# CODELY_PYTHON_DEMO_PATH=../fixtures/checklist_demo

# Optional system architecture hook. Uses bundled analyzer by default.
CODELY_SYSTEM_ARCHITECTURE_ADAPTER=


# Bind locally by default. Explicitly allow additional trusted hosts/origins if deploying.
CODELY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CODELY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CODELY_ENABLE_LEGACY_API=0
# CODELY_LEGACY_API_TOKEN=

# Absolute path to Semgrep installed in a separate tools environment.
# CODELY_SEMGREP_EXECUTABLE=
